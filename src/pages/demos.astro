---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContentCard from '../components/ContentCard.astro';
import { sortByFilename, getDemoBadges } from '../utils/content';

const posts = sortByFilename(await Astro.glob('./demos/*.mdx'));
---

<Layout title="Yaksha | Demos">
	<div class="max-w-5xl mx-auto px-6 md:px-8 pt-16 pb-16">
		<SectionHeader
			title="Demos"
			description="Interactive examples that run natively in your browser using WebAssembly (WASM)."
			count={posts.length}
		/>
		<div class="grid gap-6 md:grid-cols-2">
			{posts.map((post) => (
				<ContentCard
					href={post.url}
					title={post.frontmatter.title}
					excerpt={post.frontmatter.description}
					author={post.frontmatter.author}
					thumbnail={post.frontmatter.thumbnail}
					badges={getDemoBadges(post.frontmatter)}
				/>
			))}
		</div>
	</div>
</Layout>
