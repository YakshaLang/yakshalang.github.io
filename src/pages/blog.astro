---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContentCard from '../components/ContentCard.astro';
import { sortByDate, formatDate, extractExcerpt } from '../utils/content';

const rawPosts = sortByDate(await Astro.glob('./blog/*.{md,mdx}'));
const posts = await Promise.all(
	rawPosts.map(async (post) => ({
		url: post.url,
		title: post.frontmatter.title,
		author: post.frontmatter.author,
		excerpt:
			post.frontmatter.description ??
			extractExcerpt(await post.rawContent()),
		date: post.frontmatter.pubDate
			? formatDate(post.frontmatter.pubDate)
			: undefined,
	})),
);
---

<Layout title="Yaksha | Blog">
	<div class="max-w-3xl mx-auto px-6 md:px-8 pt-16 pb-16">
		<SectionHeader
			title="Blog"
			description="News, updates, and notes from the Yaksha project."
			count={posts.length}
		/>
		<div class="grid gap-6">
			{posts.map((post) => (
				<ContentCard
					href={post.url}
					title={post.title}
					excerpt={post.excerpt}
					author={post.author}
					date={post.date}
				/>
			))}
		</div>
	</div>
</Layout>
