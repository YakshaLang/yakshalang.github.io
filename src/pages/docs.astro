---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContentCard from '../components/ContentCard.astro';
import { sortByFilename } from '../utils/content';

const docs = sortByFilename(await Astro.glob('./docs/*.mdx'));
---

<Layout title="Yaksha | Docs">
	<div class="max-w-4xl mx-auto px-6 md:px-8 pt-16 pb-16">
		<SectionHeader
			title="Documentation"
			description="Language reference, runtime library, tools, and compiler internals."
			count={docs.length}
		/>
		<div class="grid gap-6 md:grid-cols-2">
			{docs.map((doc) => (
				<ContentCard
					href={doc.url}
					title={doc.frontmatter.title}
					excerpt={doc.frontmatter.description}
				/>
			))}
		</div>
	</div>
</Layout>
