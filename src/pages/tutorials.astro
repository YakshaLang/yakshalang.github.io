---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContentCard from '../components/ContentCard.astro';
import { sortByFilename, extractExcerpt } from '../utils/content';

const rawTutorials = sortByFilename(await Astro.glob('./tutorials/*.md'));
const tutorials = await Promise.all(
	rawTutorials.map(async (tutorial) => ({
		url: tutorial.url,
		title: tutorial.frontmatter.title,
		author: tutorial.frontmatter.author,
		excerpt:
			tutorial.frontmatter.description ??
			extractExcerpt(await tutorial.rawContent()),
	})),
);
---

<Layout title="Yaksha | Tutorials">
	<div class="max-w-3xl mx-auto px-6 md:px-8 pt-16 pb-16">
		<SectionHeader
			title="Tutorials"
			description="Step-by-step guides to get you up and running with Yaksha."
			count={tutorials.length}
		/>
		<div class="grid gap-6">
			{tutorials.map((tutorial, index) => (
				<ContentCard
					href={tutorial.url}
					title={tutorial.title}
					excerpt={tutorial.excerpt}
					author={tutorial.author}
					meta={`Step ${index + 1}`}
				/>
			))}
		</div>
	</div>
</Layout>
