---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { sortByFilename, getProposalNumber } from '../utils/content';

const posts = sortByFilename(await Astro.glob('./yama/*.md'));
---

<Layout title="Yaksha | YAMA">
	<div class="max-w-4xl mx-auto px-6 md:px-8 pt-16 pb-16">
		<SectionHeader
			title="YAMA"
			description="Yaksha Amendment proposals — language design decisions and feature requests."
			count={posts.length}
		/>
		<div class="grid gap-4">
			{posts.map((post) => (
				<a
					href={post.url}
					class="card bg-base-100 shadow-md hover:shadow-lg transition-shadow group"
				>
					<div class="card-body gap-2 flex-row items-start">
						<div class="flex flex-col gap-2 flex-1 min-w-0">
							<div class="flex flex-wrap items-center gap-2">
								<span class="badge badge-outline font-mono text-xs">
									YAMA {getProposalNumber(post.file)}
								</span>
								{post.frontmatter.status && (
									<StatusBadge status={post.frontmatter.status} />
								)}
							</div>
							<h2 class="card-title font-mono text-lg md:text-xl group-hover:text-primary transition-colors">
								{post.frontmatter.title}
							</h2>
							{post.frontmatter.description && (
								<p class="text-sm text-base-content/70 line-clamp-2">
									{post.frontmatter.description}
								</p>
							)}
							{post.frontmatter.author && (
								<p class="font-mono text-xs text-base-content/50">
									{post.frontmatter.author}
								</p>
							)}
						</div>
					</div>
				</a>
			))}
		</div>
	</div>
</Layout>
