---
import Layout from '../layouts/Layout.astro';

const {frontmatter} = Astro.props;
---
<Layout title={`Yaksha | Demo | ${frontmatter.title}`} description={frontmatter.description}>

  <div class="py-12 mx-auto w-96 md:w-[40rem]">
    <h1 class="text-center font-black text-4xl">{frontmatter.title}</h1>
    <p class="text-center pt-1">{frontmatter.author}</p>

    <div class="py-4">
      { frontmatter.demoJs != undefined &&
        <>
          <canvas class="rounded-lg w-full focus:outline focus:outline-2 focus:outline-primary" id="canvas" oncontextmenu="event.preventDefault()" tabindex="0" />
          <script is:inline>
              var Module = { canvas: document.getElementById("canvas") };

              (function () {
                  var canvas = Module.canvas;
                  var gameKeys = {
                      ArrowUp: true,
                      ArrowDown: true,
                      ArrowLeft: true,
                      ArrowRight: true,
                      " ": true,
                      Enter: true,
                  };
                  var gameKeyCodes = {
                      ArrowUp: true,
                      ArrowDown: true,
                      ArrowLeft: true,
                      ArrowRight: true,
                      Space: true,
                      Enter: true,
                  };

                  function shouldCaptureKey(event) {
                      return gameKeys[event.key] || gameKeyCodes[event.code];
                  }

                  function preventGameKeyScroll(event) {
                      if (document.activeElement === canvas && shouldCaptureKey(event)) {
                          event.preventDefault();
                      }
                  }

                  canvas.addEventListener("click", function () {
                      canvas.focus();
                  });

                  canvas.addEventListener("keydown", function (event) {
                      if (shouldCaptureKey(event)) {
                          event.preventDefault();
                      }
                  });

                  window.addEventListener("keydown", preventGameKeyScroll, { capture: true });
              })();
          </script>
      
          <script async src={frontmatter.demoJs} />
        </>
      }

      { frontmatter.demoHtml != undefined &&
        <>
          <iframe class="rounded-lg w-full aspect-video" src={frontmatter.demoHtml} />
        </>
      }
    </div>

    <div class="prose dark:prose-invert">
      <slot />
    </div>
  </div>
</Layout>