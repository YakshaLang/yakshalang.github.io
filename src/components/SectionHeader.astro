---
interface Props {
	title: string;
	description?: string;
	count?: number;
}

const { title, description, count } = Astro.props;
---

<div class="text-center mb-10">
	<h1 class="font-mono text-2xl md:text-4xl font-bold">{title}</h1>
	{description && (
		<p class="mt-3 text-sm md:text-base text-base-content/70 max-w-2xl mx-auto">
			{description}
		</p>
	)}
	{count !== undefined && (
		<div class="mt-4">
			<span class="badge badge-neutral badge-outline font-mono text-xs">
				{count} {count === 1 ? "item" : "items"}
			</span>
		</div>
	)}
</div>
